# Каддифайл для стенда: HTTPS и вход по паролю.
#
# Зачем. Сейчас приложение висит на голом адресе по http, и это значит:
#   — текст задач (то есть названия внутренних задач из Jira) едет открытым;
#   — номер комнаты, единственное, что закрывает её от посторонних, виден
#     в истории браузера, в переписке и в логах любого прокси по дороге;
#   — браузер не даёт странице доступ к буферу обмена: «скопировать ссылку»
#     работает через запасной путь.
#
# Почему прокси, а не проверка внутри приложения. Пароль должен закрывать и
# страницу, и веб-сокет одинаково. Браузер не отправляет заголовок авторизации
# при открытии веб-сокета, поэтому самодельная проверка внутри приложения
# получилась бы дырявой ровно там, где идёт вся игра.
#
# Что нужно от вас: доменное имя, направленное на этот сервер (A-запись).
# Сертификат Caddy получит сам.
#
# Установка на сервере:
#   apt install -y caddy
#   # заменить poker.example.com на своё имя
#   # пароль: caddy hash-password  — и вставить получившийся хеш ниже
#   cp Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy
#
# И после этого закрыть 8000 снаружи, оставив его только для прокси:
#   ufw delete allow 8000/tcp
#   ufw allow 80,443/tcp

poker.example.com {
	encode gzip

	# Общий пароль команды. Хеш получить командой `caddy hash-password`;
	# сам пароль в этот файл не вписывать.
	basic_auth {
		team ЗАМЕНИТЬ_НА_ХЕШ
	}

	# Веб-сокет проходит по тому же адресу и под той же проверкой
	reverse_proxy 127.0.0.1:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}
}
